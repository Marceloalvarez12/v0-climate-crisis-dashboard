# Neon: pegar la cadena PostgreSQL completa de Connect, con SSL.
# Copiar como .env.local; nunca usar NEXT_PUBLIC_ para estas credenciales.
APP_URL=http://localhost:3000
DATABASE_URL=
# npm run auth:secret lo genera sin mostrarlo.
BETTER_AUTH_SECRET=

# Integraciones opcionales, solo del lado del servidor.
API_SECRET=
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
RESEND_API_KEY=
MAIL_FROM=
ARKIV_PRIVATE_KEY=
STELLAR_SECRET_KEY=
# Solo habilitar Stellar con el hash de la VK del contrato correspondiente.
STELLAR_ZK_VK_SHA256=

# Protección compartida entre instancias (opcional para demo local).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUIRE_DISTRIBUTED=false
RATE_LIMIT_PREFIX=zntinel-local
